# Public Supabase browser/server values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Optional newer Supabase publishable key; if set it is preferred over ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Public site URL used by metadata/canonical generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only on the reviewed production domain, never on a preview.
OPIOPE_ALLOW_INDEXING=false

# Optional local auth callback override
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# GDPR / legal identity (required before production publication)
NEXT_PUBLIC_CONTROLLER_NAME=YOUR_LEGAL_COMPANY_OR_CONTROLLER_NAME
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
# Optional business/company identifier shown in legal documents if you add it
# NEXT_PUBLIC_BUSINESS_ID=1234567-8

# Server-only AI provider key; never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=

# V21 security: use a long random server-only value in production.
RATE_LIMIT_PEPPER=

# V16 optional providers / storage
OPENAI_TUTOR_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPIOPE_UPLOAD_BUCKET=learner-uploads
# Optional future OCR/document pipeline endpoint
OPIOPE_DOCUMENT_PROCESSOR_URL=
# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Teacher Content Studio (server only)
OPIOPE_AI_MODEL=
OPIOPE_TEACHER_MATERIAL_BUCKET=teacher-materials
# Optional OCR/STT processor for PDF/image/audio teacher materials.
# The processor must accept POST JSON { teacherId, materialId, purpose } with Bearer auth
# and return JSON { text: string }. Keep both values server-only.
OPIOPE_DOCUMENT_PROCESSOR_SECRET=
